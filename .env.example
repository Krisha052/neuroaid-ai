# Required only for POST /api/v1/agent/screen (src/agent/). Without it, that
# endpoint returns 503; the rest of the API (/screen, /prompts, /health)
# works fine with no key at all.
ANTHROPIC_API_KEY=

# Optional, defaults to claude-sonnet-4-5.
NEUROAID_AGENT_MODEL=

# Optional, defaults to http://localhost:8000 (used by the Streamlit client).
NEUROAID_API_BASE_URL=
